# =============================================================================
# AI ARENA — Vercel Environment Variables (import template)
# =============================================================================
#
# How to import:
# 1. copy vercel.env.example vercel.env
# 2. Replace every REPLACE_ME value
# 3. Vercel → Settings → Environment Variables → Import .env
# 4. Enable Production + Preview → Redeploy
# 5. Run supabase/schema.sql + supabase/rls-v2.sql in Supabase SQL Editor
# 6. npm run smoke:prod
#
# Do NOT commit vercel.env
# =============================================================================

# --- Public Supabase ---
NEXT_PUBLIC_SUPABASE_URL=REPLACE_ME_https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_ME_supabase_anon_public_key

# --- Server secrets (Vercel only — never NEXT_PUBLIC_) ---
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME_service_role_key
ADMIN_USERNAME=REPLACE_ME_admin
ADMIN_PASSWORD=REPLACE_ME_strong_password

# --- Optional: Live LLM (omit for mock mode on production) ---
# ANTHROPIC_API_KEY=REPLACE_ME_sk-ant-api03-...
