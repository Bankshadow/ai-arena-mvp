# =============================================================================
# AI ARENA — Vercel Environment Variables (import template)
# =============================================================================
#
# How to import:
# 1. Copy this file:  copy vercel.env.example vercel.env
# 2. Replace every REPLACE_ME value with your real keys
# 3. Vercel Dashboard → Project ai-arena → Settings → Environment Variables
# 4. Click "Import .env" → select vercel.env
# 5. Check: Production + Preview (and Development if you use Vercel dev)
# 6. Redeploy production after import
#
# Do NOT commit vercel.env (contains secrets). This template is safe to commit.
# =============================================================================

# --- Required for Submit / Leaderboard / Admin / Battle history / Tournament save ---
NEXT_PUBLIC_SUPABASE_URL=REPLACE_ME_https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_ME_supabase_anon_public_key

# --- Required for real LLM runs (Battle, Arena judge, Tournament loop, Admin Run Agent) ---
# Without this, app falls back to demo/mock mode on those features.
ANTHROPIC_API_KEY=REPLACE_ME_sk-ant-api03-...

# --- Optional: legacy OpenAI judge (submit auto-scoring scripts) ---
# OPENAI_API_KEY=REPLACE_ME_sk-...
# JUDGE_MODEL=gpt-4o-mini

# --- Optional: legacy Drizzle/Postgres (not used by Supabase MVP UI) ---
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require
