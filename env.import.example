# =============================================================================
# AI ARENA — Environment import template
# =============================================================================
# See env.import.example header in git history for full instructions.
# Copy to .env.local (local) or vercel.env (Vercel import).

# --- Supabase (public) ---
NEXT_PUBLIC_SUPABASE_URL=REPLACE_ME_https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_ME_supabase_anon_public_key

# --- Supabase CLI (schema sync — npm run supabase:push) ---
# Project ref = subdomain of URL, e.g. whnabdftddufuvgufijd from https://whnabdftddufuvgufijd.supabase.co
SUPABASE_PROJECT_REF=REPLACE_ME_project_ref
# Database password: Dashboard → Settings → Database
SUPABASE_DB_PASSWORD=REPLACE_ME_db_password
# Optional CI: Dashboard → Account → Access Tokens
# SUPABASE_ACCESS_TOKEN=REPLACE_ME_sbp_...

# --- Server-only secrets ---
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME_service_role_key
ADMIN_USERNAME=REPLACE_ME_admin
ADMIN_PASSWORD=REPLACE_ME_strong_password

# --- Optional: Live LLM (omit for mock mode) ---
# ANTHROPIC_API_KEY=REPLACE_ME_sk-ant-api03-...
