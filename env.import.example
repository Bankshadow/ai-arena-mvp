# =============================================================================
# AI ARENA — Environment import template
# =============================================================================
#
# LOCAL DEV:
#   1. Copy:  copy env.import.example .env.local
#   2. Replace every REPLACE_ME value
#   3. Restart dev server: npm run dev
#
# VERCEL:
#   1. Copy:  copy env.import.example vercel.env
#   2. Replace every REPLACE_ME value
#   3. Vercel Dashboard → Project → Settings → Environment Variables
#   4. Click "Import .env" → select vercel.env
#   5. Enable: Production + Preview (+ Development if needed)
#   6. Redeploy
#
# Do NOT commit .env.local or vercel.env (secrets). This template is safe.
# =============================================================================

# --- Supabase (Submit, Leaderboard, Battles, Tournament save) ---
NEXT_PUBLIC_SUPABASE_URL=REPLACE_ME_https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_ME_supabase_anon_public_key

# --- Anthropic (Battle live, Arena judge, Tournament LLM loop) ---
# Without this: Battle/Tournament fall back to demo/mock mode.
ANTHROPIC_API_KEY=REPLACE_ME_sk-ant-api03-...

# --- Optional: legacy OpenAI judge ---
# OPENAI_API_KEY=REPLACE_ME_sk-...
# JUDGE_MODEL=gpt-4o-mini

# --- Optional: legacy Drizzle/Postgres (not used by Supabase MVP UI) ---
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require
