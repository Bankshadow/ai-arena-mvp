# Supabase (required for MVP submissions / leaderboard / admin)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Supabase CLI — npm run supabase:push (see supabase/README.md)
# SUPABASE_PROJECT_REF="your-project-ref"
# SUPABASE_DB_PASSWORD="your-database-password"

# Legacy Drizzle/Postgres (optional — not used by Supabase MVP flow)
# DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# Anthropic AI Judge + Agent runner (optional — legacy paths)
ANTHROPIC_API_KEY="sk-ant-..."

# Tournament Engine — Groq routing (default runtime: mock; configure in /admin)
# GROQ_API_KEY="gsk_..."
# GROQ_BASE_URL="https://api.groq.com/openai/v1"
# GROQ_DEFAULT_MODEL="llama-3.1-8b-instant"

# Tournament hybrid final judge (optional — hybrid_quality mode)
# OPENAI_API_KEY="sk-..."
# TOURNAMENT_ANTHROPIC_JUDGE_MODEL="claude-sonnet-4-20250514"
# TOURNAMENT_OPENAI_JUDGE_MODEL="gpt-4o-mini"

# Legacy AI Judge (optional)
# JUDGE_MODEL="gpt-4o-mini"
